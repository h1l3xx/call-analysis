# Malikov Backend — переменные окружения
# Скопируй в .env и заполни

POSTGRES_PASSWORD=malikov_dev
DB_APP_PASSWORD=malikov_dev
JWT_SECRET=change_me_in_production_must_be_32_chars_minimum
ENVIRONMENT=development

# Python AI Pipeline
PYTHON_PIPELINE_URL=http://localhost:8001
PIPELINE_API_KEY=
PIPELINE_TIMEOUT_SECONDS=300

# Path to the pipeline repo (inside the project by default)
PIPELINE_BUILD_CONTEXT=./pipeline

# Auto-bootstrap for pipeline repo (used by scripts/deploy.sh)
PIPELINE_GIT_URL=https://github.com/FUYOH666/Scanovich.ai-audio-call.git
PIPELINE_GIT_REF=main
APPLY_PIPELINE_PATCH=true
PIPELINE_PATCH_FILE=./patches/pipeline-custom-v2.patch

# Optional second env-file with GPU profile, e.g.
# deploy/vllm/profiles/l4-24gb.env
VLLM_PROFILE_ENV=

# Enable vLLM sidecar (docker-compose.vllm.yml)
ENABLE_VLLM=false
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ
VLLM_DTYPE=auto
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=8
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_SHM_SIZE=16gb
VLLM_EXTRA_ARGS=
VLLM_PORT=8000
VLLM_CACHE_DIR=./.cache/huggingface
HUGGING_FACE_HUB_TOKEN=
# HuggingFace token for pyannote.audio speaker diarization (accept license at https://huggingface.co/pyannote/speaker-diarization-3.1)
HF_TOKEN=

# Pipeline -> vLLM integration overrides
PIPELINE_VLLM_ENABLED=false
PIPELINE_VLLM_BASE_URL=http://vllm:8000/v1
PIPELINE_VLLM_TIMEOUT=300
PIPELINE_VLLM_RETRY_ATTEMPTS=3
PIPELINE_VLLM_RETRY_DELAY=2.0
PIPELINE_QUALITY_ENABLED=true
PIPELINE_QUALITY_TIMEOUT=300
PIPELINE_QUALITY_RETRY_ATTEMPTS=3

# Pipeline -> external LLM API (OpenRouter/OpenAI-compatible)
# Used by both: Python pipeline (quality analysis) AND Kotlin backend (batch evaluation, summaries)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
PIPELINE_QUALITY_PROVIDER=openrouter
PIPELINE_QUALITY_MODEL=openai/gpt-4.1
PIPELINE_QUALITY_BASE_URL=https://openrouter.ai/api/v1
PIPELINE_QUALITY_API_KEY_ENV=OPENROUTER_API_KEY

# Audio storage and cleanup
AUDIO_STORAGE_PATH=/data/audio
AUDIO_RETENTION_DAYS=30

# Telegram bot (per-user reports via bot linking)
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_REPORT_DAILY_ENABLED=true
TELEGRAM_REPORT_WEEKLY_ENABLED=true
TELEGRAM_DAILY_TIME=09:00
TELEGRAM_WEEKLY_DAY=monday
TELEGRAM_WEEKLY_TIME=10:00
TELEGRAM_LINK_CODE_TTL_MINUTES=5

# Pipeline analytics (passed to Python pipeline container)
ANALYTICS_ENABLED=true
TELEGRAM_ENABLED=false
TELEGRAM_CHAT_ID=

# Public ports (used by docker-compose.prod.yml)
FRONTEND_PORT=80
APP_PORT=8080
