# ====================================================================
# Malikov Production Environment — RTX 2080Ti / i5-12600 / 32GB RAM
# Скопировать в .env и заполнить ВСЕ значения помеченные <<<
# ====================================================================

# ── Режим ──────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=<<<CHANGE_ME_strong_password>>>
DB_APP_PASSWORD=<<<CHANGE_ME_another_strong_password>>>

# ── JWT ────────────────────────────────────────────────────────────
# Минимум 32 символа. Сгенерировать: openssl rand -base64 48
JWT_SECRET=<<<CHANGE_ME_openssl_rand_base64_48>>>

# ── Pipeline (Scanovich.ai-audio-call) ────────────────────────────
PIPELINE_BUILD_CONTEXT=./pipeline
PIPELINE_GIT_URL=https://github.com/FUYOH666/Scanovich.ai-audio-call.git
PIPELINE_GIT_REF=main
APPLY_PIPELINE_PATCH=true
PIPELINE_PATCH_FILE=./patches/pipeline-custom-v2.patch

# GPU Dockerfile (используется в docker-compose.prod.yml)
PIPELINE_DOCKERFILE_GPU=../pipeline-gpu.Dockerfile

# Pipeline API key (внутренний, между backend и pipeline)
PIPELINE_API_KEY=<<<CHANGE_ME_internal_api_key>>>
PIPELINE_REQUIRE_API_KEY=true

# ── HuggingFace Token ─────────────────────────────────────────────
# Нужен для pyannote.audio (диаризация спикеров)
# Получить: https://huggingface.co/settings/tokens
# Принять лицензию: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=<<<YOUR_HF_TOKEN>>>

# ── LLM API (OpenRouter / OpenAI-compatible) ──────────────────────
# Используется Python pipeline (quality analysis) И Kotlin backend (batch eval, summaries)
OPENROUTER_API_KEY=<<<YOUR_OPENROUTER_API_KEY>>>
OPENAI_API_KEY=
PIPELINE_QUALITY_ENABLED=true
PIPELINE_QUALITY_PROVIDER=openrouter
PIPELINE_QUALITY_MODEL=openai/gpt-4.1
PIPELINE_QUALITY_BASE_URL=https://openrouter.ai/api/v1
PIPELINE_QUALITY_API_KEY_ENV=OPENROUTER_API_KEY
PIPELINE_QUALITY_TIMEOUT=300
PIPELINE_QUALITY_RETRY_ATTEMPTS=3

# ── GPU / vLLM (опционально, если хотите локальную LLM) ──────────
ENABLE_VLLM=false

# ── Audio storage and cleanup ──────────────────────────────────
AUDIO_STORAGE_PATH=/data/audio
AUDIO_RETENTION_DAYS=30

# ── Telegram Bot ──────────────────────────────────────────────────
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_REPORT_DAILY_ENABLED=true
TELEGRAM_REPORT_WEEKLY_ENABLED=true
TELEGRAM_DAILY_TIME=09:00
TELEGRAM_WEEKLY_DAY=monday
TELEGRAM_WEEKLY_TIME=10:00
TELEGRAM_LINK_CODE_TTL_MINUTES=5

# Pipeline-side telegram (legacy)
ANALYTICS_ENABLED=true
TELEGRAM_ENABLED=false
TELEGRAM_CHAT_ID=

# ── Порты (на хосте) ─────────────────────────────────────────────
FRONTEND_PORT=80
APP_PORT=8080
