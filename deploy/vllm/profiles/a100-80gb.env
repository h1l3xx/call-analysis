# NVIDIA A100 80GB / H100 80GB (single GPU)
ENABLE_VLLM=true
VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct-AWQ
VLLM_DTYPE=auto
VLLM_GPU_MEMORY_UTILIZATION=0.93
VLLM_MAX_MODEL_LEN=16384
VLLM_MAX_NUM_SEQS=12
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_SHM_SIZE=32gb
VLLM_EXTRA_ARGS=
PIPELINE_VLLM_TIMEOUT=600
PIPELINE_QUALITY_TIMEOUT=600
