# 2x A100/H100 80GB (tensor parallel)
ENABLE_VLLM=true
VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct-AWQ
VLLM_DTYPE=auto
VLLM_GPU_MEMORY_UTILIZATION=0.93
VLLM_MAX_MODEL_LEN=24576
VLLM_MAX_NUM_SEQS=20
VLLM_TENSOR_PARALLEL_SIZE=2
VLLM_SHM_SIZE=48gb
VLLM_EXTRA_ARGS=
PIPELINE_VLLM_TIMEOUT=900
PIPELINE_QUALITY_TIMEOUT=900
